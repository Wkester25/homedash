[Unit]
Description=HomeDash network vitals dashboard
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
WorkingDirectory=/home/pi/homedash
ExecStart=/home/pi/homedash/.venv/bin/python /home/pi/homedash/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
